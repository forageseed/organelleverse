# Publication exports: keep editable SVG, PDF and lightweight PNG previews;
# journal-scale TIFFs and iterative repair renders are reproducible locally.
/paper_figures/outputs/*.tiff
/paper_figures/supplementary_figures/*.tiff
/paper_figures/svg_work/**/previews/
/paper_figures/svg_work/**/rounds/

